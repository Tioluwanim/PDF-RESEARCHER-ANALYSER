APP_TITLE="PDF Research Analyzer"
APP_VERSION="1.1.0"
DEBUG=false
LOG_LEVEL=INFO

# Local default uses SQLite. On Render, set DATABASE_URL to the managed
# PostgreSQL internal connection string.
DATABASE_URL=sqlite:///data/pdf_analyzer.db
SQLALCHEMY_ECHO=false

# Google Drive service-account sync.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CREDENTIALS_PATH=credentials.json

# LLM providers.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct:cerebras

# Local embeddings and retrieval.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MIN_CHUNK_LENGTH=50
TOP_K_RESULTS=8
SIMILARITY_THRESHOLD=0.05

MAX_FILE_SIZE_MB=50
MAX_CHAT_HISTORY=50
